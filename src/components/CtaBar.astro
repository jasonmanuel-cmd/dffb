---
export interface Props {
  headline: string;
  cta?: string;
  ctaLink?: string;
}

const { headline, cta, ctaLink } = Astro.props;
---

<section class="my-16 md:my-20">
  <div class="relative overflow-hidden card card-hover flex flex-col md:flex-row items-start md:items-center justify-between gap-5 p-7 md:p-9">
    <div aria-hidden="true" class="absolute inset-0 pointer-events-none opacity-30"
      style="background: radial-gradient(ellipse 60% 80% at 20% 50%, rgba(200,163,84,0.04) 0%, transparent 70%);">
    </div>
    <div class="relative">
      <h2 class="text-xl md:text-2xl font-display font-semibold text-balance text-beige m-0">{headline}</h2>
    </div>
    {cta && (
      <a href={ctaLink || "/contact"} class="btn btn-primary text-sm whitespace-nowrap shrink-0 relative">
        {cta}
      </a>
    )}
  </div>
</section>
