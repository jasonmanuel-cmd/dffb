---
export interface Props {
  title?: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="my-16 md:my-20">
  {title && (
    <div class="reveal mb-8">
      <h2 class="heading-md text-balance mb-3">{title}</h2>
      {subtitle && <p class="text-text-light/60 max-w-[60ch]">{subtitle}</p>}
    </div>
  )}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
    <div class="card card-accent card-hover reveal reveal-delay-1 tabular-nums">
      <div class="text-gold text-[2.5rem] md:text-[3rem] font-display font-semibold leading-none mb-2">$32K</div>
      <p class="font-semibold text-white text-sm">Monthly revenue per home</p>
      <p class="text-xs text-text-light/50 mt-1">6–10 residents at market rates</p>
    </div>
    <div class="card card-accent card-hover reveal reveal-delay-2 tabular-nums">
      <div class="text-gold text-[2.5rem] md:text-[3rem] font-display font-semibold leading-none mb-2">$8K</div>
      <p class="font-semibold text-white text-sm">Monthly net profit per home</p>
      <p class="text-xs text-text-light/50 mt-1">After operating costs and staffing</p>
    </div>
    <div class="card card-accent card-hover reveal reveal-delay-3 tabular-nums">
      <div class="text-gold text-[2.5rem] md:text-[3rem] font-display font-semibold leading-none mb-2">6–10</div>
      <p class="font-semibold text-white text-sm">Residents per property</p>
      <p class="text-xs text-text-light/50 mt-1">Small-home model for higher margins</p>
    </div>
  </div>
  <p class="reveal reveal-delay-4 text-xs text-text-light/30 mt-5 max-w-[55ch]">
    Representative economics based on current DFFB operating homes. Actual results vary by property, occupancy, and market conditions.
  </p>
</section>
