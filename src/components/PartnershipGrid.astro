---
import type { Props as CtaBarProps } from "./CtaBar.astro";
import CtaBar from "./CtaBar.astro";
---

<section class="my-16 md:my-20">
  <div class="reveal mb-10">
    <h2 class="heading-md text-balance">Who We Partner With</h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
    <div class="card card-hover reveal reveal-delay-1 flex flex-col">
      <span class="text-xs uppercase tracking-widest text-gold font-semibold mb-2">For Owners</span>
      <h3 class="text-xl font-display font-semibold text-white mb-2">Property Owners & Landlords</h3>
      <p class="text-sm text-text-light/65 leading-relaxed flex-1 mb-5">
        Convert your property from traditional rental to a licensed residential care facility. DFFB handles licensing, staffing, operations, and compliance. You collect rent backed by recurring care revenue.
      </p>
      <a href="/owners" class="btn btn-secondary text-sm self-start">Learn More</a>
    </div>
    <div class="card card-hover reveal reveal-delay-2 flex flex-col">
      <span class="text-xs uppercase tracking-widest text-gold font-semibold mb-2">For Investors</span>
      <h3 class="text-xl font-display font-semibold text-white mb-2">Capital & Investment Partners</h3>
      <p class="text-sm text-text-light/65 leading-relaxed flex-1 mb-5">
        Direct property investment or partnership with a vertically integrated operator. Recurring revenue, real estate appreciation, and demographic tailwinds. Multiple entry points.
      </p>
      <a href="/investors" class="btn btn-secondary text-sm self-start">View Thesis</a>
    </div>
    <div class="card card-hover reveal reveal-delay-3 flex flex-col">
      <span class="text-xs uppercase tracking-widest text-gold font-semibold mb-2">For Partners</span>
      <h3 class="text-xl font-display font-semibold text-white mb-2">Operators & PM Companies</h3>
      <p class="text-sm text-text-light/65 leading-relaxed flex-1 mb-5">
        Access centralized licensing support, staffing pipelines, compliance infrastructure, and care coordination. Keep your identity while leveraging institutional-grade backend systems.
      </p>
      <a href="/partner" class="btn btn-secondary text-sm self-start">Explore Models</a>
    </div>
    <div class="card card-hover reveal reveal-delay-4 flex flex-col">
      <span class="text-xs uppercase tracking-widest text-gold font-semibold mb-2">For Families</span>
      <h3 class="text-xl font-display font-semibold text-white mb-2">Families Seeking Care</h3>
      <p class="text-sm text-text-light/65 leading-relaxed flex-1 mb-5">
        Safe, affordable, home-style senior housing with continuum-of-care support. Small homes with personalized assistance from independent living through assisted care.
      </p>
      <a href="/contact?type=family" class="btn btn-secondary text-sm self-start">Find Care</a>
    </div>
  </div>
</section>
