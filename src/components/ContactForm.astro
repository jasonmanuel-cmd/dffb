---
import site from "../content/site.json";
---

<section class="my-14">
  <form id="contact-form" action="https://formspree.io/f/xwvknjyb" method="POST" accept-charset="UTF-8" class="card max-w-2xl mx-auto space-y-5">
    <h2 class="text-2xl md:text-3xl font-semibold text-beige mb-4">Get in Touch</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="name" class="block text-xs uppercase tracking-widest text-text-light/60 mb-1.5">Full Name</label>
        <input type="text" id="name" name="name" required minlength="2" maxlength="100" placeholder="Your name" class="w-full bg-white/5 border border-white/15 rounded-lg px-4 py-3 text-white text-sm placeholder:text-text-light/50 focus:outline-none focus:border-gold/60 transition-colors" />
      </div>
      <div>
        <label for="email" class="block text-xs uppercase tracking-widest text-text-light/60 mb-1.5">Email Address</label>
        <input type="email" id="email" name="email" required minlength="5" maxlength="254" placeholder="your@email.com" class="w-full bg-white/5 border border-white/15 rounded-lg px-4 py-3 text-white text-sm placeholder:text-text-light/50 focus:outline-none focus:border-gold/60 transition-colors" />
      </div>
    </div>

    <div>
      <label for="interest" class="block text-xs uppercase tracking-widest text-text-light/60 mb-1.5">I am a...</label>
      <select id="interest" name="_subject" class="w-full bg-white/5 border border-white/15 rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:border-gold/60 transition-colors">
        <option value="" selected disabled>Select interest &hellip;</option>
        <option value="Property Owner Inquiry">Property Owner</option>
        <option value="Investor Inquiry">Investor / Capital Partner</option>
        <option value="Operator Partnership Inquiry">Operator / Property Manager</option>
        <option value="Family / Resident Inquiry">Family Seeking Care</option>
        <option value="General Inquiry">Other</option>
      </select>
    </div>

    <div>
      <label for="message" class="block text-xs uppercase tracking-widest text-text-light/60 mb-1.5">Message</label>
      <textarea id="message" name="message" required rows="5" minlength="10" maxlength="5000" placeholder="Tell us about your property, investment goals, or care needs..." class="w-full bg-white/5 border border-white/15 rounded-lg px-4 py-3 text-white text-sm placeholder:text-text-light/50 focus:outline-none focus:border-gold/60 transition-colors resize-y"></textarea>
    </div>

    <input type="hidden" name="_to" value={site.email} />
    <input type="hidden" name="_replyto" value="email" />

    <button type="submit" class="btn btn-primary text-base w-full md:w-auto" data-cta="form-submit">
      Send Message
    </button>

    <p class="text-xs text-text-light/50 text-center">
      This form sends directly to <a href={`mailto:${site.email}`} class="text-beige no-underline">{site.email}</a>. No spam.
    </p>
  </form>
</section>
