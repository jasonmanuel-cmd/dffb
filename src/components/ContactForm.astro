---
import site from "../content/site.json";
---

<section class="my-16 md:my-20">
  <form id="contact-form" action="https://formspree.io/f/xwvknjyb" method="POST" accept-charset="UTF-8" class="card max-w-xl mx-auto space-y-5">
    <h2 class="heading-md text-balance mb-2">Get in Touch</h2>
    <p class="text-sm text-text-light/60 mb-4">Fill out the form and we'll get back to you within 48 hours.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="name" class="block text-xs uppercase tracking-widest text-text-light/40 mb-1.5 font-medium">Full Name</label>
        <input type="text" id="name" name="name" required minlength="2" maxlength="100" placeholder="Your name" class="w-full bg-white/[0.04] border border-white/[0.1] rounded-xl px-4 py-3 text-white text-sm placeholder:text-text-light/30 focus:outline-none focus:border-gold/50 focus:bg-white/[0.06] transition-all duration-300" />
      </div>
      <div>
        <label for="email" class="block text-xs uppercase tracking-widest text-text-light/40 mb-1.5 font-medium">Email Address</label>
        <input type="email" id="email" name="email" required minlength="5" maxlength="254" placeholder="your@email.com" class="w-full bg-white/[0.04] border border-white/[0.1] rounded-xl px-4 py-3 text-white text-sm placeholder:text-text-light/30 focus:outline-none focus:border-gold/50 focus:bg-white/[0.06] transition-all duration-300" />
      </div>
    </div>

    <div>
      <label for="interest" class="block text-xs uppercase tracking-widest text-text-light/40 mb-1.5 font-medium">I am a...</label>
      <select id="interest" name="_subject" class="w-full bg-white/[0.04] border border-white/[0.1] rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-gold/50 focus:bg-white/[0.06] transition-all duration-300">
        <option value="" selected disabled class="bg-navy-dark">Select interest &hellip;</option>
        <option value="Property Owner Inquiry" class="bg-navy-dark">Property Owner</option>
        <option value="Investor Inquiry" class="bg-navy-dark">Investor / Capital Partner</option>
        <option value="Operator Partnership Inquiry" class="bg-navy-dark">Operator / Property Manager</option>
        <option value="Family / Resident Inquiry" class="bg-navy-dark">Family Seeking Care</option>
        <option value="General Inquiry" class="bg-navy-dark">Other</option>
      </select>
    </div>

    <div>
      <label for="message" class="block text-xs uppercase tracking-widest text-text-light/40 mb-1.5 font-medium">Message</label>
      <textarea id="message" name="message" required rows="5" minlength="10" maxlength="5000" placeholder="Tell us about your property, investment goals, or care needs..." class="w-full bg-white/[0.04] border border-white/[0.1] rounded-xl px-4 py-3 text-white text-sm placeholder:text-text-light/30 focus:outline-none focus:border-gold/50 focus:bg-white/[0.06] transition-all duration-300 resize-y"></textarea>
    </div>

    <input type="hidden" name="_to" value={site.email} />
    <input type="hidden" name="_replyto" value="email" />

    <button type="submit" class="btn btn-primary text-base w-full md:w-auto" data-cta="form-submit">
      Send Message
    </button>

    <p class="text-xs text-text-light/30 text-center">
      This form sends directly to <a href={`mailto:${site.email}`} class="text-beige/70 no-underline hover:text-beige">{site.email}</a>.
    </p>
  </form>
</section>

<script>
  const MAKE_WEBHOOK = 'https://hook.us2.make.com/j1sezo54ipnlrut56bh4ylit5yo9rqr5';

  document.getElementById('contact-form')?.addEventListener('submit', function () {
    const name = (document.getElementById('name') as HTMLInputElement)?.value?.trim() || '';
    const nameParts = name.split(' ');
    const firstName = nameParts[0] || '';
    const lastName = nameParts.slice(1).join(' ') || '';
    const email = (document.getElementById('email') as HTMLInputElement)?.value?.trim() || '';
    const interest = (document.getElementById('interest') as HTMLSelectElement)?.value || '';
    const message = (document.getElementById('message') as HTMLTextAreaElement)?.value?.trim() || '';
    const params = new URLSearchParams(window.location.search);

    const leadScore = 10 + (email ? 5 : 0) + (interest ? 5 : 0);
    const leadGrade = leadScore >= 90 ? 'Hot' : leadScore >= 70 ? 'Warm' : 'Nurture';

    const payload = {
      'First Name': firstName,
      'Last Name': lastName,
      'Email': email,
      'Phone': '',
      'Company': '',
      'Service': interest,
      'Who For': '',
      'Timeframe': '',
      'Budget': '',
      'Decision Maker': '',
      'Contact Method': 'Email',
      'Best Time': '',
      'Consultation': '',
      'Message': message,
      'Lead Score': leadScore,
      'Lead Grade': leadGrade,
      'UTM Source': params.get('utm_source') || 'direct',
      'UTM Medium': params.get('utm_medium') || '',
      'UTM Campaign': params.get('utm_campaign') || '',
      'Timestamp': new Date().toISOString()
    };

    fetch(MAKE_WEBHOOK, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
      mode: 'no-cors'
    }).catch(() => {});
  });
</script>
