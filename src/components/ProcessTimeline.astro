---
export interface Props {
  title?: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="my-16 md:my-20">
  {title && (
    <div class="reveal mb-8">
      <h2 class="heading-md text-balance mb-3">{title}</h2>
      {subtitle && <p class="text-text-light/60 max-w-[60ch]">{subtitle}</p>}
    </div>
  )}
  <div class="space-y-4 md:space-y-5">
    <div class="card card-hover flex gap-4 md:gap-5 items-start reveal">
      <span class="bg-gold/15 text-gold text-lg font-bold rounded-full w-9 h-9 flex items-center justify-center shrink-0 mt-0.5 font-display">1</span>
      <div>
        <h3 class="font-display font-semibold text-white mb-1">Contact & Qualification</h3>
        <p class="text-sm text-text-light/60">Submit your property or interest. We review location, layout, zoning, and partnership fit within 48 hours.</p>
      </div>
    </div>
    <div class="card card-hover flex gap-4 md:gap-5 items-start reveal reveal-delay-1">
      <span class="bg-gold/15 text-gold text-lg font-bold rounded-full w-9 h-9 flex items-center justify-center shrink-0 mt-0.5 font-display">2</span>
      <div>
        <h3 class="font-display font-semibold text-white mb-1">Proposal & Structure</h3>
        <p class="text-sm text-text-light/60">We present a detailed partnership structure with revenue projections, operating plan, and legal framework.</p>
      </div>
    </div>
    <div class="card card-hover flex gap-4 md:gap-5 items-start reveal reveal-delay-2">
      <span class="bg-gold/15 text-gold text-lg font-bold rounded-full w-9 h-9 flex items-center justify-center shrink-0 mt-0.5 font-display">3</span>
      <div>
        <h3 class="font-display font-semibold text-white mb-1">Licensing & Setup</h3>
        <p class="text-sm text-text-light/60">DFFB manages CDSS licensing, fire/life safety approvals, staffing recruitment, and operational setup.</p>
      </div>
    </div>
    <div class="card card-hover flex gap-4 md:gap-5 items-start reveal reveal-delay-3">
      <span class="bg-gold/15 text-gold text-lg font-bold rounded-full w-9 h-9 flex items-center justify-center shrink-0 mt-0.5 font-display">4</span>
      <div>
        <h3 class="font-display font-semibold text-white mb-1">Operations & Revenue</h3>
        <p class="text-sm text-text-light/60">Home goes live. DFFB manages day-to-day operations, resident placement, care coordination, and compliance. You receive predictable income.</p>
      </div>
    </div>
  </div>
</section>
