    <p class="text-xs uppercase tracking-widest text-text-light/50 font-semibold mb-5">Trusted Partners & Certifications</p>
    <div class="flex flex-wrap justify-center gap-6 md:gap-8 text-xs text-text-light/60">
      <span class="px-4 py-2.5 border border-white/15 rounded-xl bg-white/[0.04] font-semibold">CDSS Licensed</span>
      <span class="px-4 py-2.5 border border-white/15 rounded-xl bg-white/[0.04] font-semibold">Fire/Life Safety Approved</span>
      <span class="px-4 py-2.5 border border-white/15 rounded-xl bg-white/[0.04] font-semibold">KHSA Member</span>
      <span class="px-4 py-2.5 border border-white/15 rounded-xl bg-white/[0.04] font-semibold">Community Outreach</span>
    </div>
  </div>
</section>
