---
import site from "../content/site.json";
---

<section class="my-16 md:my-20 reveal">
  <div class="text-center">
    <p class="text-xs uppercase tracking-widest text-text-light/30 font-semibold mb-5">Trusted Partners & Certifications</p>
    <div class="flex flex-wrap justify-center gap-3 md:gap-4 text-xs text-text-light/50">
      <span class="px-4 py-2.5 border border-white/[0.06] rounded-xl font-semibold">CDSS Licensed</span>
      <span class="px-4 py-2.5 border border-white/[0.06] rounded-xl font-semibold">Fire/Life Safety Approved</span>
      <span class="px-4 py-2.5 border border-white/[0.06] rounded-xl font-semibold">KHSA Member</span>
      <span class="px-4 py-2.5 border border-white/[0.06] rounded-xl font-semibold">Community Outreach</span>
    </div>
  </div>
</section>
