---
import site from "../content/site.json";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/partner", label: "Partner With Us" },
  { href: "/owners", label: "For Property Owners" },
  { href: "/investors", label: "For Investors" },
  { href: "/model", label: "Our Model" },
  { href: "/markets", label: "Markets" },
  { href: "/faq", label: "FAQ" },
  { href: "/assessment", label: "Assessment" },
];
---

<header class="sticky top-0 z-50 bg-navy-dark/94 backdrop-blur-md border-b border-white/[0.06]">
  <div class="header-inner section-container flex items-center justify-between gap-4 md:gap-6 py-3 md:py-3.5 relative">
    <a href="/" class="flex items-center gap-3 no-underline shrink-0">
      <picture>
        <source srcset="/dffb-logo-small.webp" type="image/webp" />
        <img src="/dffb-logo-small.png" alt="DFFB Senior Living logo" width="200" height="207" class="w-10 h-10 md:w-[46px] md:h-[46px] object-contain" decoding="async" />
      </picture>
      <span class="font-display font-semibold text-beige tracking-widest text-sm md:text-base">
        DFFB SENIOR LIVING
      </span>
      <span class="hidden md:inline text-sm text-gold/90 font-semibold ml-1 md:ml-2 pl-3 md:pl-4 border-l border-white/[0.1] whitespace-nowrap">
        (661) 448-2386
      </span>
    </a>

    <button
      class="nav-toggle lg:hidden inline-flex items-center justify-center min-w-[44px] min-h-[44px] px-4 border border-white/[0.12] bg-white/[0.04] text-beige rounded-xl text-sm font-semibold cursor-pointer transition-colors hover:bg-white/[0.08] active:scale-[0.97]"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Open menu"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <nav
      id="primary-nav"
      aria-label="Primary"
      class="hidden lg:flex lg:flex-wrap lg:items-center lg:gap-1 absolute lg:relative top-full left-0 right-0 bg-navy-dark/98 lg:bg-transparent border-b lg:border-0 border-white/[0.06] rounded-b-2xl lg:rounded-none shadow-2xl lg:shadow-none p-4 lg:p-0 flex-col lg:flex-row max-h-[calc(100vh-92px)] overflow-auto lg:max-h-none"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="nav-link text-sm text-text-light/85 hover:text-beige no-underline transition-colors py-2.5 lg:py-1.5 px-3 lg:px-3.5 rounded-lg lg:rounded-none relative"
        >
          {link.label}
        </a>
      ))}
      <a href="/contact" class="btn btn-primary text-sm whitespace-nowrap mt-2 lg:mt-0 lg:ml-2">Book a Partnership Call</a>
    </nav>
  </div>
</header>

<style>
  .header-inner.menu-open nav {
    display: flex;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: #c8a354;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateX(-50%);
    border-radius: 1px;
  }
  .nav-link:hover::after,
  .nav-link.active::after {
    width: 60%;
  }
  .nav-link.active {
    color: #f3e8d5;
  }

  @media (max-width: 1023px) {
    nav a, nav .btn {
      width: 100%;
      text-align: left;
    }
    nav .btn {
      justify-content: center;
      margin-top: 0.5rem;
    }
    .nav-link::after {
      display: none;
    }
  }
</style>

<script>
  (function () {
    var path = window.location.pathname.replace(/\/$/, "") || "";
    document.querySelectorAll(".nav-link").forEach(function (el) {
      var href = el.getAttribute("href").replace(/\/$/, "") || "";
      if (path === href || (href && path.startsWith(href + "/"))) {
        el.classList.add("active");
      }
    });
  })();
</script>
