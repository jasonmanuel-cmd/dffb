---
export interface Props {
  title?: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
const markets = [
  {
    name: "Bakersfield",
    status: "Active",
    description: "Our flagship market. Multiple licensed homes currently operating with strong occupancy and community partnerships.",
    highlights: ["9+ licensed homes", "High occupancy rates", "Strong referral pipeline"]
  },
  {
    name: "Los Angeles Basin",
    status: "Growth",
    description: "High-density market with significant unmet demand for small-home RCFEs. Active property acquisition and partnership outreach underway.",
    highlights: ["Active acquisitions", "Regulatory ready", "Partner network established"]
  },
  {
    name: "Central Valley Corridor",
    status: "Exploration",
    description: "Strategically positioned for demographic demand. Evaluating properties and partnership opportunities across Fresno, Visalia, and surrounding areas.",
    highlights: ["Demographic analysis complete", "Site selection in progress", "Partner recruitment open"]
  }
];
---

<section class="my-14">
  {title && (
    <div class="mb-8">
      <h2 class="text-2xl md:text-3xl font-semibold text-beige mb-3">{title}</h2>
      {subtitle && <p class="text-text-light/80 max-w-[65ch]">{subtitle}</p>}
    </div>
  )}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {markets.map((m) => (
      <div class="card flex flex-col">
        <div class="flex items-center gap-2 mb-2.5">
          <h3 class="text-xl font-semibold text-white m-0">{m.name}</h3>
          <span class="text-xs uppercase tracking-widest font-semibold text-gold">{m.status}</span>
        </div>
        <p class="text-sm text-text-light/80 leading-relaxed flex-1">{m.description}</p>
        <ul class="mt-3 space-y-1 text-xs text-text-light/60">
          {m.highlights.map((h) => (
            <li class="flex items-center gap-1.5"><span class="text-gold">&check;</span> {h}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
